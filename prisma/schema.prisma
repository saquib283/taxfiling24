generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?  // Display Name
  username  String   @unique
  password  String   // Hashed
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   @default("Briefcase")
  category    String   @default("General")
  href        String?
  createdAt   DateTime @default(now())
}

model Article {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.Text   // Rich text content from TipTap
  excerpt      String?  @db.Text   // Short list description
  thumbnailUrl String?             // Featured Image link
  
  category     ArticleCategory?    // Uses PostgreSQL Enum
  tags         String[] @default([]) // Array of tags for categorization
  readTime     Int?                // e.g., 5 min
  isFeatured   Boolean  @default(false)
  views        Int      @default(0)
  
  metaTitle       String?
  metaDescription String?          // limit 155 chars
  
  published    Boolean  @default(false)
  author       String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publishedAt  DateTime?           // For scheduling or explicitly set dates
}

enum ArticleCategory {
  BUSINESS_REGISTRATION
  INCOME_TAX_FILING
  GST_COMPLIANCE
  ACCOUNTING_BOOKKEEPING
  AUDIT_ASSURANCE
  TRADEMARK_IP
  LEGAL_AGREEMENTS
  ROC_COMPLIANCE
  CORPORATE_INVESTIGATION
  STARTUP_FUNDING
  CERTIFICATIONS_ISO
  E_COMMERCE_BANKING
  PAYROLL_PF_ESI
  NRI_TAXATION
  GENERAL_UPDATES
}



model Setting {
  id          String  @id @default(cuid())
  key         String  @unique  // e.g. 'GEMINI_API_KEY'
  value       String  @db.Text
  description String?          // e.g. 'Gemini AI API Key for Chatbot'
}

model Review {
  id         String   @id @default(cuid())
  name       String
  role       String?  // Company or Designation
  content    String   @db.Text
  rating     Int      @default(5)
  avatar     String?  // image url or initials controller
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String   @db.Text
  status    String   @default("PENDING") // PENDING, RESOLVED, ARCHIVED
  createdAt DateTime @default(now())
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  designation String
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model ComplianceDeadline {
  id       String   @id @default(cuid())
  title    String
  category String   // "Income Tax", "GST", "Labor Law"
  date     DateTime
  desc     String   @db.Text
  isActive Boolean  @default(true)
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // "CREATED", "UPDATED", "DELETED"
  entity    String   // "Article", "Service", "FAQ", etc.
  entityId  String?
  details   String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

model Campaign {
  id        String   @id @default(cuid())
  subject   String
  content   String   @db.Text
  status    String   @default("DRAFT") // DRAFT, SENT
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

