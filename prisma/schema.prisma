generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?  // Display Name
  username  String   @unique
  password  String   // Hashed
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Service {
  id                String   @id @default(cuid())
  slug              String   @unique @default(uuid())
  title             String
  description       String   @db.Text
  overview          String?  @db.Text
  heroBg            String?  @default("from-blue-600 to-indigo-700")
  icon              String   @default("Briefcase")
  category          String   @default("General")
  href              String?
  benefits          Json?
  subServices       Json?
  documentsRequired Json?
  process           Json?
  faqs              Json?
  createdAt         DateTime @default(now())
}

model Article {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.Text   // Rich text content from TipTap
  excerpt      String?  @db.Text   // Short list description
  thumbnailUrl String?             // Featured Image link
  
  category     ArticleCategory?    // Uses PostgreSQL Enum
  tags         Json?               // Changed from String[] to Json? for MySQL compatibility
  readTime     Int?                // e.g., 5 min
  isFeatured   Boolean  @default(false)
  views        Int      @default(0)
  
  metaTitle       String?
  metaDescription String?          // limit 155 chars
  
  published    Boolean  @default(false)
  author       String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publishedAt  DateTime?           // For scheduling or explicitly set dates
}

enum ArticleCategory {
  BUSINESS_REGISTRATION
  INCOME_TAX_FILING
  GST_COMPLIANCE
  ACCOUNTING_BOOKKEEPING
  AUDIT_ASSURANCE
  TRADEMARK_IP
  LEGAL_AGREEMENTS
  ROC_COMPLIANCE
  CORPORATE_INVESTIGATION
  STARTUP_FUNDING
  CERTIFICATIONS_ISO
  E_COMMERCE_BANKING
  PAYROLL_PF_ESI
  NRI_TAXATION
  GENERAL_UPDATES
}

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique  // e.g. 'GEMINI_API_KEY'
  value       String  @db.Text
  description String?          // e.g. 'Gemini AI API Key for Chatbot'
}

model Review {
  id         String   @id @default(cuid())
  name       String
  role       String?  // Company or Designation
  content    String   @db.Text
  rating     Int      @default(5)
  avatar     String?  // image url or initials controller
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Inquiry {
  id             String         @id @default(cuid())
  name           String
  email          String
  phone          String?
  service        String?
  message        String         @db.Text
  status         String         @default("NEW") // "NEW", "CONTACTED", "FOLLOW_UP_SCHEDULED", "CONSULTATION_BOOKED", "PROPOSAL_SENT", "WON", "LOST", "ARCHIVED"
  priority       String         @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  estimatedValue Float?         // Deal value in INR ₹
  assignedTo     String?        // Staff or CA name
  company        String?        // Business or Firm name
  city           String?
  source         String         @default("WEBSITE_FORM") // "WEBSITE_FORM", "WHATSAPP", "PHONE", "REFERRAL"
  tags           Json?          // Array of tags
  lostReason     String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  followUps      LeadFollowUp[]
  activities     LeadActivity[]
  proposals      LeadProposal[]
  whatsappLogs   WhatsAppLog[]
}

model LeadFollowUp {
  id           String    @id @default(cuid())
  inquiryId    String
  inquiry      Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  type         String    @default("CALL") // "CALL", "WHATSAPP", "EMAIL", "MEETING", "TASK"
  title        String
  notes        String?   @db.Text
  status       String    @default("PENDING") // "PENDING", "COMPLETED", "CANCELLED", "MISSED"
  outcome      String?   @db.Text
  completedAt  DateTime?
  assignedTo   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([inquiryId])
  @@index([scheduledAt])
  @@index([status])
}

model LeadActivity {
  id          String   @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type        String   // "NOTE", "CALL", "EMAIL", "WHATSAPP", "STATUS_CHANGE", "FOLLOW_UP_CREATED", "FOLLOW_UP_COMPLETED", "VALUE_UPDATED", "PROPOSAL_CREATED", "PROPOSAL_SENT", "PROPOSAL_ACCEPTED"
  title       String
  description String?  @db.Text
  metadata    Json?
  performedBy String   @default("Admin")
  createdAt   DateTime @default(now())

  @@index([inquiryId])
  @@index([createdAt])
}

model LeadProposal {
  id             String    @id @default(cuid())
  inquiryId      String
  inquiry        Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  proposalNumber String    @unique // e.g. "TF24-QT-2026-001"
  title          String    // e.g. "Private Limited Incorporation & Annual Compliance"
  status         String    @default("DRAFT") // "DRAFT", "SENT", "ACCEPTED", "REJECTED", "EXPIRED"
  validUntil     DateTime
  lineItems      Json      // Array of: { description, sacCode, qty, rate, gstPercent, amount }
  subtotal          Float
  discount          Float     @default(0)
  taxAmount         Float     // 18% GST (CGST+SGST or IGST)
  totalAmount       Float     // Grand total in INR ₹
  currency          String    @default("INR")
  clientGstin       String?
  clientPan         String?
  clientAddress     String?
  placeOfSupply     String?   // e.g. "07-DELHI", "27-MAHARASHTRA"
  taxType           String    @default("IGST") // "IGST" or "CGST_SGST"
  paymentMilestones Json?
  notes             String?   @db.Text
  terms          String?   @db.Text // Terms of Engagement & Payment Schedule
  pdfUrl         String?
  sentAt         DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([inquiryId])
  @@index([proposalNumber])
  @@index([status])
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  designation String
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model ComplianceDeadline {
  id       String   @id @default(cuid())
  title    String
  category String   // "Income Tax", "GST", "Labor Law"
  date     DateTime
  desc     String   @db.Text
  isActive Boolean  @default(true)
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // "CREATED", "UPDATED", "DELETED"
  entity    String   // "Article", "Service", "FAQ", etc.
  entityId  String?
  details   String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  source    String   @default("NEWSLETTER") // "NEWSLETTER", "INQUIRY", "APPOINTMENT", "CSV_IMPORT", "MANUAL"
  tags      Json?    // Array of string tags e.g. ["GST", "Startup", "Nov2026"]
  company   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isActive  Boolean  @default(true)
}

model Campaign {
  id                String            @id @default(cuid())
  name              String?
  subject           String
  preheader         String?
  content           String            @db.Text
  status            String            @default("DRAFT") // DRAFT, SENDING, SENT, PARTIAL_FAILURE
  provider          String            @default("SMTP")
  audience          String            @default("ALL_ACTIVE")
  fromName          String?
  fromEmail         String?
  replyTo           String?
  externalId        String?
  templateId        String?
  template          CampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientCount    Int               @default(0)
  sentCount         Int               @default(0)
  deliveredCount    Int               @default(0)
  openedCount       Int               @default(0)
  readCount         Int               @default(0)
  clickedCount      Int               @default(0)
  bouncedCount      Int               @default(0)
  failedCount       Int               @default(0)
  complaintCount    Int               @default(0)
  unsubscribedCount Int               @default(0)
  sentAt            DateTime?
  lastEventAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  events            CampaignEvent[]
  whatsappLogs      WhatsAppLog[]
}

model CampaignTemplate {
  id            String     @id @default(cuid())
  name          String
  description   String?
  category      String     @default("Newsletter")
  subject       String
  preheader     String?
  content       String     @db.Text
  isAiGenerated Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
}

model CampaignEvent {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider       String
  eventType      String
  providerEventId String?
  recipientEmail String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@unique([campaignId, provider, providerEventId], map: "campaign_provider_event_unique")
}

model Appointment {
  id                 String   @id @default(cuid())
  bookingReference   String?  @unique
  name               String
  email              String
  phone              String
  service            String?
  serviceId          String?
  date               DateTime
  time               String
  slotLabel          String?
  startAt            DateTime?
  endAt              DateTime?
  durationMinutes    Int?
  customerTimezone   String?
  locationType       String?
  locationLabel      String?
  meetingLink        String?
  message            String?  @db.Text
  adminNotes         String?  @db.Text
  cancellationReason String?  @db.Text
  status             String   @default("PENDING") // PENDING, CONFIRMED, RESCHEDULED, CANCELLED, COMPLETED, NO_SHOW
  source             String   @default("WEBSITE")
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  reminderCount      Int      @default(0)
  sentReminderOffsets String?
  meetingLinkSentAt  DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WhatsAppLog {
  id              String    @id @default(cuid())
  messageId       String?   // Meta wamid
  direction       String    // "INBOUND" | "OUTBOUND" | "STATUS_UPDATE"
  fromNumber      String    // Sender phone (E.164 digits)
  toNumber        String    // Recipient phone (E.164 digits)
  senderName      String?   // Profile name from WhatsApp contacts
  messageType     String    @default("text") // "text", "template", "image", "document", "audio", "video", "interactive", "status", "unknown"
  content         String?   @db.Text // Message body, template summary, or caption
  mediaUrl        String?   @db.Text // Media ID or asset URL
  mediaMimeType   String?
  status          String    @default("received") // "received", "sent", "delivered", "read", "failed"
  errorCode       String?
  errorMessage    String?   @db.Text
  pricingCategory String?   // "service", "utility", "marketing", "authentication"
  rawPayload      Json?     // Full raw Meta webhook JSON for forensic audit
  
  // Relations & Linkage
  inquiryId       String?
  inquiry         Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([messageId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([direction])
  @@index([status])
  @@index([createdAt])
  @@index([inquiryId])
  @@index([campaignId])
}
